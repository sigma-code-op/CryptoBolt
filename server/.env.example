# Copy this file to .env. Nothing here is required to be a real secret —
# this server no longer holds a Groq API key of its own. Each visitor supplies
# their own key from the app UI, sent per-request, never stored server-side.
#
# ⚠️  TIME-SENSITIVE: the default GROQ_MODEL below (llama-3.3-70b-versatile) is
# scheduled to STOP WORKING on 2026-08-16. If you're reading this on or after
# that date, the AI Insight panel will return errors until you change GROQ_MODEL
# below to a currently-supported model (check https://console.groq.com/docs/models)
# and update it in your host's environment variables — no code change needed.

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s)).
# MUST match the exact origin shown in your browser's address bar (protocol + host + port) —
# http://localhost:5500 and http://127.0.0.1:5500 are DIFFERENT origins, as are two different
# ports. If you open index.html in a new browser/tab/tool and the AI panel stops working, this
# is almost always why — check the origin your frontend is actually served from and put it here.
# Example: https://sigma-code-op.github.io,http://localhost:5500,http://127.0.0.1:5500
ALLOWED_ORIGINS=http://api.cryptobolt.io,http://www.cryptobolt.io

# Port the server listens on (most hosts override this automatically).
PORT=8787

# Which Groq-hosted model to use. Groq has been retiring its Llama lineup — Llama 4
# Scout/Maverick are already gone, and llama-3.1-8b-instant / llama-3.3-70b-versatile are
# scheduled to shut down 2026-08-16. Check https://console.groq.com/docs/models for what's
# currently live and update this if requests start failing.
GROQ_MODEL=openai/gpt-oss-120b
# Requests allowed per IP per window for the AI insight endpoint (protects against abuse
# regardless of whose key is being used).
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MINUTES=15

# ---- Live research (no keys required) ----
# Every /api/ai-insight request now also pulls, server-side, in parallel with the AI call:
#  - Recent (last 72h) news headlines for the asset from CryptoCompare's free news API
#  - The market-wide Fear & Greed Index from Alternative.me
# Both are public, keyless endpoints. Nothing to configure — this is documented here so you
# know why the server needs outbound internet access to min-api.cryptocompare.com and
# api.alternative.me, and so hosts with an egress allowlist (e.g. some serverless platforms)
# know which domains to permit. If either call fails or times out (4.5s / 3.5s), the AI insight
# still returns normally — it just reasons without that extra context for that one request.

# ---- Contact form (POST /api/contact) ----
# Sends submissions from contact.html over SMTP via nodemailer. Without these four vars set,
# the endpoint returns a 503 and the frontend falls back to a mailto: link automatically.
#
# If you're on Hostinger and set up an email account (e.g. hello@cryptobolt.io) under
# Hostinger -> Emails for your domain, use Hostinger's SMTP details:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=hello@cryptobolt.io          (the full mailbox address)
#   SMTP_PASS=your mailbox password
# Any other SMTP provider (Gmail app password, SendGrid, Resend SMTP, etc.) works the same way —
# just swap in that provider's host/port/credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where contact-form messages get delivered, and what "From" address they're sent as.
# CONTACT_FROM_EMAIL can be left blank to just reuse SMTP_USER as the From address.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Requests allowed per IP per window for the contact form (keeps it from being spammed).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
