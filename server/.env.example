# Copy this file to .env and fill in the values you need.
# `cp .env.example .env`
#
# Nothing here needs to be secret except the SMTP password — Groq keys are BYOK and are
# never stored server-side (see README.md).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Port the server listens on.
PORT=8787

# Set to "production" on a real deployment. Required for CORS to lock down to
# ALLOWED_ORIGINS — the server refuses to start in production with ALLOWED_ORIGINS empty.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API, e.g.:
#   ALLOWED_ORIGINS=https://cryptobolt.io,https://www.cryptobolt.io
# Leave empty in development to allow any origin. Must be set in production.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Groq
# ---------------------------------------------------------------------------

# Groq model used for both the research and synthesis passes. See README.md for a note on
# Groq retiring older Llama models — check https://console.groq.com/docs/models if this
# stops working.
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# AI rate limiting (/api/ai-chat, /api/ai-insight)
# ---------------------------------------------------------------------------

AI_RATE_LIMIT_WINDOW_MINUTES=15
AI_RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Contact form rate limiting (/api/contact)
# ---------------------------------------------------------------------------

CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# SMTP (contact form email). Leave all four unset to disable the contact form
# (POST /api/contact will return 503 "isn't set up on this deployment yet").
# Example values below are for Hostinger's Business/Unlimited mailbox plans.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
# Optional — defaults to SMTP_USER if unset.
CONTACT_FROM_EMAIL=
