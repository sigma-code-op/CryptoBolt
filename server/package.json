{
  "name": "cryptobolt-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend proxy for CryptoBolt. Passes each visitor's own Groq API key through to Groq's Llama models via a rate-limited /api/ai-insight endpoint.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "groq-sdk": "^0.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16"
  }
}