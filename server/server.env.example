# Copy this file to .env and fill in the values you need.
# `cp .env.example .env`
#
# Nothing here needs to be secret except the SMTP password — Groq keys are BYOK and are
# never stored server-side (see README.md).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Port the server listens on.
PORT=8787

# Set to "production" on a real deployment. Required for CORS to lock down to
# ALLOWED_ORIGINS — the server refuses to start in production with ALLOWED_ORIGINS empty.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API, e.g.:
#   ALLOWED_ORIGINS=https://cryptobolt.io,https://www.cryptobolt.io
# Leave empty in development to allow any origin. Must be set in production.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Supabase (server-side, for db.js only — see db.js for details)
# ---------------------------------------------------------------------------

# Same project as js/00-config.js's supabaseUrl, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# The SERVICE ROLE key (Project Settings -> API), NOT the public anon key already used
# client-side. This is a secret — never commit it or put it in any frontend file.
SUPABASE_API_KEY=

# ---------------------------------------------------------------------------
# Groq
# ---------------------------------------------------------------------------

# Groq model used for both the research and synthesis passes. See README.md for a note on
# Groq retiring older Llama models — check https://console.groq.com/docs/models if this
# stops working.
GROQ_MODEL=openai/gpt-oss-120b

# Optional "house" key. Leave unset to keep CryptoBolt strict BYOK (default). Set this to
# your own Groq key to let visitors flip a switch in the UI and use CryptoBolt's key
# instead of pasting their own gsk_... key. This key is billed to YOU for every visitor who
# uses it, so it's protected by its own, much tighter rate limit below — tune those numbers
# to what you're comfortable paying for before enabling this in production.
GROQ_HOUSE_API_KEY=

# ---------------------------------------------------------------------------
# AI rate limiting (/api/ai-chat, /api/ai-insight)
# ---------------------------------------------------------------------------

# Applies to requests using a visitor's own key (BYOK) — cost is on their account, so this
# just guards against hammering the endpoint.
AI_RATE_LIMIT_WINDOW_MINUTES=15
AI_RATE_LIMIT_MAX=30

# Applies to requests using GROQ_HOUSE_API_KEY above — cost is on YOUR account, so this
# should be noticeably stricter. Only matters if GROQ_HOUSE_API_KEY is set.
HOUSE_KEY_RATE_LIMIT_WINDOW_MINUTES=60
HOUSE_KEY_RATE_LIMIT_MAX=6

# ---------------------------------------------------------------------------
# Contact form rate limiting (/api/contact)
# ---------------------------------------------------------------------------

CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# SMTP (contact form email). Leave all four unset to disable the contact form
# (POST /api/contact will return 503 "isn't set up on this deployment yet").
# Example values below are for Hostinger's Business/Unlimited mailbox plans.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
# Optional — defaults to SMTP_USER if unset.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Closed-tab push alerts (server/src/lib/alert-checker.js, js/23-push-alerts.js)
#
# Lets a price alert fire even after the tab that set it is closed. Needs
# BOTH this section and SUPABASE_URL/SUPABASE_API_KEY above — leave any of
# the four required values below unset to keep this feature off (existing
# in-tab alerts keep working exactly as before either way).
# ---------------------------------------------------------------------------

# Generate a pair once per deployment with: npx web-push generate-vapid-keys
# The public key is also served to the browser at GET /api/push/vapid-public-key —
# it's not a secret. The private key must stay server-side only.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Contact address push services can reach if a deployment's pushes ever misbehave. Never
# shown to visitors. Defaults to CONTACT_TO_EMAIL above if unset (as mailto:<that address>) —
# only set this separately if you want push complaints to land somewhere else.
PUSH_VAPID_SUBJECT=

# How often (seconds) the server re-checks every signed-in visitor's alerts against live
# Binance prices. Lower = alerts fire sooner after the target is hit, at the cost of one more
# Binance REST call per interval (a single request checks every symbol, so this doesn't scale
# with visitor count).
ALERT_CHECK_INTERVAL_SECONDS=45

# ---------------------------------------------------------------------------
# AI call track record (server/src/lib/ai-call-tracker.js)
#
# Logs every structured trade setup the AI Market Insight panel produces and auto-resolves
# it against live prices for a public win-rate readout (GET /api/ai-calls/track-record).
# Needs ONLY SUPABASE_URL/SUPABASE_API_KEY above — independent of the push-alert section,
# so this can be on even on a deployment with no Web Push configured at all. Leave those two
# unset to keep this feature off.
# ---------------------------------------------------------------------------

# How often (seconds) the server re-checks open AI calls against live Binance prices.
AI_CALL_CHECK_INTERVAL_SECONDS=60

# How long (hours) an AI call can sit unresolved before it's marked "expired" instead of a
# win or a loss.
AI_CALL_EXPIRY_HOURS=72
