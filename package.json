{
  "name": "cryptobolt",
  "version": "1.0.0",
  "private": true,
  "description": "CryptoBolt frontend build tooling — Tailwind CSS compile, JS bundling/minification, and CSP <meta> tag generation for the static site. The backend proxy lives in server/ with its own package.json.",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:css-bundle && npm run build:js && npm run build:csp",
    "build:css": "tailwindcss -i css/tailwind-input.css -o css/tailwind.css --minify && node scripts/normalize-tailwind-css.js",
    "build:css-bundle": "node scripts/build-css.js && node scripts/prune-css-bundle.js",
    "build:js": "node scripts/build-js.js",
    "build:blog": "node scripts/build-blog.js",
    "build:csp": "node scripts/build-csp.js",
    "test": "node --test test/*.test.js",
    "build:glossary": "node scripts/build-glossary.js",
    "build:og": "python3 scripts/generate-og-images.py",
    "build:og-cards": "python3 scripts/generate-og-cards.py",
    "check:seo": "node scripts/check-seo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "postcss": "^8.5.0",
    "postcss-selector-parser": "^7.1.0",
    "terser": "^5.36.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}