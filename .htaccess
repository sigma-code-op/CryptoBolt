<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Link "</sitemap.xml>; rel=\"sitemap\", </privacy.html>; rel=\"privacy-policy\""
</IfModule>

# Any URL that does not exist (e.g. /op.html) shows the custom 404 page
ErrorDocument 404 /404.html


# The old "live price" pages were replaced by dedicated coin pages (2026-10-28).
# Permanent redirects so old links and any indexed copies land on the new URLs.
<IfModule mod_alias.c>
  Redirect 301 /bitcoin-live-price.html https://cryptobolt.io/bitcoin.html
  Redirect 301 /ethereum-live-price.html https://cryptobolt.io/ethereum.html
  Redirect 301 /solana-live-price.html https://cryptobolt.io/solana.html
</IfModule>
