<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Link '</sitemap.xml>; rel="sitemap", </privacy>; rel="privacy-policy"'
</IfModule>

# Any URL that does not exist (e.g. /op.html) shows the custom 404 page
ErrorDocument 404 /404.html


# The old "live price" pages were replaced by dedicated coin pages (2026-10-28).
# Permanent redirects so old links and any indexed copies land on the new URLs.
<IfModule mod_alias.c>
  Redirect 301 /bitcoin-live-price.html https://cryptobolt.io/bitcoin
  Redirect 301 /ethereum-live-price.html https://cryptobolt.io/ethereum
  Redirect 301 /solana-live-price.html https://cryptobolt.io/solana
</IfModule>


# ---------------------------------------------------------------------------
# Markdown for AI agents. A request for a page with "Accept: text/markdown"
# gets the pre-built Markdown twin from /md/ (scripts/build-markdown.py);
# everyone else still gets HTML. Vary tells caches the response depends on Accept.
# ---------------------------------------------------------------------------
AddType text/markdown .md
AddDefaultCharset UTF-8
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Send www.cryptobolt.io to the bare domain (fixes Ahrefs "no self-referencing hreflang" and duplicate-host crawling)
  RewriteCond %{HTTP_HOST} ^www\.cryptobolt\.io$ [NC]
  RewriteRule ^(.*)$ https://cryptobolt.io/$1 [R=301,L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^$ /md/index.md [L]
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/md/$1.md -f
  RewriteRule ^([A-Za-z0-9-]+)(?:\.html)?$ /md/$1.md [L]

  # ---- Clean URLs: /ebook serves ebook.html, and /ebook.html redirects (301) to /ebook ----
  # account.html keeps its extension (login redirects point at it). 404.html is served internally.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.html[\s?]
  RewriteCond %{REQUEST_URI} !^/(account|404)\.html$
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|md)$">
    Header merge Vary Accept
  </FilesMatch>
  <FilesMatch "^$">
    Header merge Vary Accept
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Speed (Apache hosts only; GitHub Pages ignores this file and already gzips):
# compress text assets and let browsers cache static files.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/markdown application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>